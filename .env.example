# Copy this file to .env.local and fill in real values.
# Never commit real secrets — .env.local is gitignored.
#
# Get a WalletConnect project ID at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
#
# LI.FI API key for higher rate limits (request one at https://li.fi).
# The widget works without it (200 requests / 2 hours), with it (200 / minute).
NEXT_PUBLIC_LIFI_API_KEY=
#
# Integrator name sent to LI.FI for attribution/fees.
NEXT_PUBLIC_INTEGRATOR=rhswap
#
# Public site URL used for metadataBase and OG/Twitter card URLs.
NEXT_PUBLIC_SITE_URL=https://rhswap.xyz
